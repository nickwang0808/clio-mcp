{
  "name": "@nickwang0808/clio-mcp",
  "version": "2.4.0",
  "mcpName": "io.github.nickwang0808/clio-mcp",
  "description": "MCP connector for Clio Manage with 45 tools to read and manage matters, contacts, notes, tasks, documents, calendar entries, activities, and billing information. Supports local stdio and HTTP/SSE transports, optional read-only mode, and library use.",
  "main": "build/lib.js",
  "types": "build/lib.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.js"
    },
    "./lib": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --project tsconfig.build.json && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "start": "node build/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run build && npm test && npm run verify:no-secrets",
    "verify:no-secrets": "node scripts/verify-no-secrets.mjs"
  },
  "bin": {
    "clio-mcp": "build/index.js"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickwang0808/clio-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "clio",
    "legal-tech",
    "law-firm",
    "practice-management",
    "oauth"
  ],
  "author": "Nick Wang <nick@highvizcto.com> (https://github.com/nickwang0808)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nickwang0808/clio-mcp/issues"
  },
  "homepage": "https://github.com/nickwang0808/clio-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  }
}
